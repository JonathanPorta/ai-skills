  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracker state",
  "description": "State for the configurable-workstream EBCD-format map. This schema validates shape; renderer validation also checks dates, safe evidence URLs, and exact template fields.",
  "$defs": {
    "githubIssues": {
      "type": "array",
      "uniqueItems": true,
      "description": "GitHub issue associations. The renderer also verifies that each URL matches repository and number. Empty for historical work with no issue.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "number",
          "url"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
          }
        }
      }
    }
  }
